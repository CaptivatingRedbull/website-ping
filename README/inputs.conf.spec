[web_ping://<name>]
url = <string>
* The URL to check.

title = <string>
* Display name. Defaults to the URL.

timeout = <integer>
* Seconds. Default 30.

user_agent = <string>
* User Agent sent to the Website.

max_redirects = <integer>
* Maximum number of redirects before a request fails.

log_level = <string> 
* Log Level for this URL. Defaults to INFO.
