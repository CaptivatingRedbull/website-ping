{
  "searches": [
    {
      "app": "website_monitoring",
      "name": "empty-fields",
      "query": "search index=main sourcetype=web_ping _index_earliest={since} title=refused | eval response_code_is=if(isnull(response_code),\"null\",\"set\"), total_time_is=if(isnull(total_time),\"null\",\"set\"), proxy_port_is=if(isnull(proxy_port),\"null\",\"set\") | stats count by response_code_is total_time_is proxy_port_is",
      "question": "Are the empty values of a failed check (response_code=\"\") null at search time?",
      "rows": [
        {
          "count": "<volatile>",
          "proxy_port_is": "set",
          "response_code_is": "set",
          "total_time_is": "set"
        }
      ]
    },
    {
      "app": "website_monitoring",
      "name": "match-empty-response-code",
      "query": "search index=main sourcetype=web_ping _index_earliest={since} (title=status-200 OR title=status-503 OR title=refused OR title=timeout OR title=match-no) response_code=\"\" | stats count by title",
      "question": "Which titles does response_code=\"\" match?",
      "rows": [
        {
          "count": "<volatile>",
          "title": "refused"
        },
        {
          "count": "<volatile>",
          "title": "timeout"
        }
      ]
    },
    {
      "app": "website_monitoring",
