      "query": "search index=main sourcetype=web_ping _index_earliest={since} (title=status-200 OR title=status-503 OR title=refused OR title=timeout OR title=match-no) NOT response_code=\"*\" | stats count by title",
      "question": "Which titles does NOT response_code=\"*\" match?",
      "rows": []
    },
